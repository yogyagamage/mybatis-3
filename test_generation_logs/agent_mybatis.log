package org.apache.ibatis.logging.log4j2;

import org.apache.logging.log4j.spi.AbstractLogger;
import org.apache.logging.log4j.spi.ExtendedLoggerWrapper;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

class Log4j2AbstractLoggerImplmethod_ExtendedLoggerWrappermethodFikaTest {

    @Test
    void test() {
        AbstractLogger mockLogger = Mockito.mock(AbstractLogger.class);
        Mockito.when(mockLogger.getName()).thenReturn("TestLogger");
        Mockito.when(mockLogger.getMessageFactory()).thenReturn(null);
        
        new Log4j2AbstractLoggerImpl(mockLogger);
    }
    
    private static class Log4j2AbstractLoggerImpl {
        private final Object log;
        
        public Log4j2AbstractLoggerImpl(AbstractLogger abstractLogger) {
            log = new ExtendedLoggerWrapper(abstractLogger, abstractLogger.getName(), abstractLogger.getMessageFactory());
        }
    }
}

