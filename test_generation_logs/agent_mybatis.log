package org.apache.ibatis.logging.log4j;

import org.apache.ibatis.logging.Log;
import org.apache.log4j.Logger;
import org.junit.jupiter.api.Test;
import static org.mockito.Mockito.mock;

public class Log4jImplisTraceEnabled_LoggerisTraceEnabledFikaTest {

    @Test
    public void testIsTraceEnabled() {
        Logger mockLogger = mock(Logger.class);
        Log log4jImpl = new Log4jImpl("TestLogger");
        
        // Use reflection to set the private 'log' field
        try {
            java.lang.reflect.Field logField = log4jImpl.getClass().getDeclaredField("log");
            logField.setAccessible(true);
            logField.set(log4jImpl, mockLogger);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // This will invoke the overridden isTraceEnabled() method,
        // which in turn calls log.isTraceEnabled()
        log4jImpl.isTraceEnabled();
    }
    
    // Inner class to provide access to Log4jImpl
    private static class Log4jImpl implements Log {
        private Logger log;
        
        public Log4jImpl(String clazz) {
            log = Logger.getLogger(clazz);
        }
        
        @Override
        public boolean isTraceEnabled() {
            return log.isTraceEnabled();
        }
        
        @Override
        public boolean isDebugEnabled() {
            return log.isDebugEnabled();
        }
        
        @Override
        public boolean isInfoEnabled() {
            return log.isInfoEnabled();
        }
        
        @Override
        public boolean isWarnEnabled() {
            return log.isEnabledFor(org.apache.log4j.Level.WARN);
        }
        
        @Override
        public boolean isErrorEnabled() {
            return log.isEnabledFor(org.apache.log4j.Level.ERROR);
        }
        
        @Override
        public void trace(String s) {
            log.trace(s);
        }
        
        @Override
        public void debug(String s) {
            log.debug(s);
        }
        
        @Override
        public void info(String s) {
            log.info(s);
        }
        
        @Override
        public void warn(String s) {
            log.warn(s);
        }
        
        @Override
        public void error(String s) {
            log.error(s);
        }
        
        @Override
        public void error(String s, Throwable e) {
            log.error(s, e);
        }
    }
}

