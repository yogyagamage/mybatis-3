                Object[] valuesArray = constructorArgs.toArray(new Object[constructorArgs.size()]);
                enhanced = enhancer.create(typesArray, valuesArray);
            }
            return enhanced;
        }
    }

    interface WriteReplaceInterface {
    }
}

