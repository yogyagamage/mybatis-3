package org.apache.ibatis.logging.log4j2;

import org.apache.ibatis.logging.Log;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

public class Log4j2AbstractLoggerImpltrace_SimpleMessagemethodFikaTest {

    @Test
    public void testTraceMethodCallsSimpleMessageConstructor() {
        Log log = Mockito.mock(Log.class);
        Log4j2AbstractLoggerImpl logger = new Log4j2AbstractLoggerImpl(log);
        
        logger.trace("test message");
    }
    
    private static class Log4j2AbstractLoggerImpl {
        private final Log log;
        
        public Log4j2AbstractLoggerImpl(Log log) {
            this.log = log;
        }
        
        public void trace(String s) {
            log.logIfEnabled("org.apache.ibatis.logging.log4j2.Log4j2AbstractLoggerImpl", 
                org.apache.logging.log4j.Level.TRACE, 
                null, 
                ((org.apache.logging.log4j.message.Message) (new org.apache.logging.log4j.message.SimpleMessage(s))), 
                null);
        }
    }
    
    private interface Log {
        void logIfEnabled(String fqcn, org.apache.logging.log4j.Level level, 
                          org.apache.logging.log4j.Marker marker, 
                          org.apache.logging.log4j.message.Message message, 
                          Throwable t);
    }
}

